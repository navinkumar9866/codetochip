{
  "id": "aries-v3",
  "name": "ARIES v3.0 (THEJAS32)",
  "vendor": "C-DAC",
  "arch": "rv32im",
  "family": "vega-thejas32",
  "toolchain": {
    "kind": "arduino-cli",
    "fqbn": "vega:riscv:aries_v3",
    "core": "vega:riscv",
    "coreVersion": "1.1.3",
    "indexUrl": "https://gitlab.com/riscv-vega/vega-arduino/-/raw/main/package_vega_index.json"
  },
  "artifact": {
    "format": "bin"
  },
  "usb": [
    {
      "vendorId": "0x10C4",
      "productId": "0xEA60",
      "bridge": "cp210x"
    }
  ],
  "serial": {
    "baudRate": 115200
  },
  "flash": {
    "protocol": "vega-xmodem",
    "modes": [
      {
        "id": "ram",
        "label": "Run from RAM (lost on power-off)",
        "target": "ram",
        "bootSel": "open",
        "buildOptions": {
          "upload_method": "xmodemMethod"
        },
        "maxImageBytes": 254976
      },
      {
        "id": "persistent",
        "label": "Save to flash",
        "target": "persistent",
        "bootSel": "TBD",
        "buildOptions": {
          "upload_method": "serialMethod"
        },
        "maxImageBytes": 254976,
        "helper": "flasher_arduino.bin"
      }
    ],
    "reset": {
      "method": "manual",
      "prompt": "Press the RESET button on the board."
    },
    "afterCancel": "reset-required"
  },
  "memory": {
    "ramBytes": 262144,
    "flashBytes": 2097152
  },
  "docsUrl": "https://vegaprocessors.in/ariesv3.php",
  "help": {
    "setup": [
      "Remove the BOOT SEL jumper (J12) so the board starts in its bootloader when you press RESET.",
      "Connect the board with a USB cable that carries data (many cables only charge)."
    ],
    "troubleshooting": [
      "If the upload waits forever, press the RESET button on the board.",
      "If the board was running a program from flash, check that the BOOT SEL jumper (J12) is removed.",
      "After a cancelled or failed upload, press RESET before trying again."
    ]
  }
}
