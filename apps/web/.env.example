# Copy to .env.production.local (git-ignored) with the values from
# `firebase apps:sdkconfig WEB <app-id> --project <project-id>`.
# With none set, the app talks to the local Firebase emulators.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# The compile server (deploy/compile-vm), e.g. https://compile.example.com. Empty means this
# site's own /api, which the dev server proxies to :3001.
VITE_COMPILE_URL=
