# Copy to .env on the VM.
# The compile server's hostname. Its DNS must point at this VM's static IP. Without a domain,
# use the IP with dashes on sslip.io, e.g. 34-100-1-2.sslip.io
COMPILE_HOST=
# Sites that may call the API, comma-separated.
ALLOWED_ORIGINS=https://codetochip.web.app,https://codetochip.firebaseapp.com
# Only users signed in to this Firebase project may compile.
FIREBASE_PROJECT_ID=codetochip
# Parallel compiles: about one per vCPU.
WORKER_CONCURRENCY=2
# Per signed-in user.
COMPILES_PER_MINUTE=30
# New compiles are refused while this many wait.
MAX_QUEUED=100
